# Used only by the Vite development proxy. Never put DB credentials or JWT_SECRET here.
API_PROXY_TARGET=http://127.0.0.1:8080

# Current backend supports these operations. Set false when using an older API.
VITE_ENABLE_RENTAL_CREATION=true
VITE_ENABLE_USER_STATUS_UPDATES=true
VITE_ENABLE_RENTAL_STATUS_UPDATES=true
