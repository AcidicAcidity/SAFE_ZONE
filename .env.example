# Local API -> Docker PostgreSQL. Compose overrides DB_URL with the db service address.
DB_URL=jdbc:postgresql://localhost:5433/safe_zone
DB_NAME=safe_zone
DB_USER=postgres
DB_PASSWORD=change_me
DB_PORT=5432

# Generate a key: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
JWT_SECRET=

ADMIN_LOGIN=admin
ADMIN_PASSWORD=change_me
